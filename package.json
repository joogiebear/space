{
  "name": "cosmos-atlas",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "description": "Animated WebGL atlas of the universe, from galaxies to satellites in Earth orbit",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api": "python -m server 8080"
  },
  "dependencies": {
    "satellite.js": "5.0.0",
    "three": "0.187.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-beta.2",
    "@emnapi/runtime": "2.0.0-beta.2",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "jsdom": "^31.0.1",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
